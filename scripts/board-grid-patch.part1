const fs = require('fs');

const htmlPath = 'makevcf.html';
const specPath = '規格書.MD';
const readmePath = 'README.md';

function findMatchingBrace(source, openIndex) {
  let depth = 0;
  let quote = null;
  let escaped = false;
  let lineComment = false;
  let blockComment = false;

  for (let i = openIndex; i < source.length; i++) {
    const ch = source[i];
    const next = source[i + 1];

    if (lineComment) {
      if (ch === '\n') lineComment = false;
      continue;
    }
    if (blockComment) {
      if (ch === '*' && next === '/') {
        blockComment = false;
        i++;
      }
      continue;
    }
    if (quote) {
      if (escaped) {
        escaped = false;
      } else if (ch === '\\') {
        escaped = true;
      } else if (ch === quote) {
        quote = null;
      }
      continue;
    }
    if (ch === '/' && next === '/') {
      lineComment = true;
      i++;
      continue;
    }
    if (ch === '/' && next === '*') {
      blockComment = true;
      i++;
      continue;
    }
    if (ch === '"' || ch === "'" || ch === '`') {
      quote = ch;
      continue;
    }
    if (ch === '{') depth++;
    else if (ch === '}') {
      depth--;
      if (depth === 0) return i;
    }
  }
  throw new Error('找不到函式結尾大括號');
}

function replaceFunction(source, marker, replacement) {
  const start = source.indexOf(marker);
  if (start < 0) throw new Error('找不到函式：' + marker);
  const open = source.indexOf('{', start);
  if (open < 0) throw new Error('找不到函式起始大括號：' + marker);
  const end = findMatchingBrace(source, open);
  return source.slice(0, start) + replacement + source.slice(end + 1);
}

const detectorBlock = String.raw`  function clamp01(value) {
    return Math.max(0, Math.min(1, value));
  }

  function quadArea(quad) {
    let sum = 0;
    for (let i = 0; i < 4; i++) {
      const a = quad[i];
      const b = quad[(i + 1) % 4];
      sum += a.x * b.y - b.x * a.y;
    }
    return Math.abs(sum) * 0.5;
  }

  function cross3(a, b, c) {
    return (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
  }

  function isUsableQuad(quad, width, height) {
    if (!quad || quad.length !== 4 || quad.some(p => !Number.isFinite(p.x) || !Number.isFinite(p.y))) return false;
    const ordered = orderCorners(quad);
    const area = quadArea(ordered);
    if (area < width * height * 0.075 || area > width * height * 1.35) return false;
    const marginX = width * 0.2;
    const marginY = height * 0.2;
    if (ordered.some(p => p.x < -marginX || p.x > width + marginX || p.y < -marginY || p.y > height + marginY)) return false;
    const signs = [];
    for (let i = 0; i < 4; i++) signs.push(cross3(ordered[i], ordered[(i + 1) % 4], ordered[(i + 2) % 4]));
    if (signs.some(v => Math.abs(v) < 1e-5)) return false;
    if (!(signs.every(v => v > 0) || signs.every(v => v < 0))) return false;
    const sides = ordered.map((p, i) => Math.sqrt(dist2(p, ordered[(i + 1) % 4])));
    const minSide = Math.min(...sides);
    const maxSide = Math.max(...sides);
    return minSide >= Math.min(width, height) * 0.16 && maxSide / Math.max(1, minSide) < 5.5;
  }

  function insetQuad(quad, ratio) {
    const center = quad.reduce((acc, p) => ({ x: acc.x + p.x / 4, y: acc.y + p.y / 4 }), { x: 0, y: 0 });
    return quad.map(p => ({
      x: p.x + (center.x - p.x) * ratio,
      y: p.y + (center.y - p.y) * ratio,
    }));
  }

  function mapUnitSquareToQuad(u, v, quad) {
    const q = orderCorners(quad);
    const p0 = q[0], p1 = q[1], p2 = q[2], p3 = q[3];
    const dx1 = p1.x - p2.x;
    const dx2 = p3.x - p2.x;
    const dx3 = p0.x - p1.x + p2.x - p3.x;
    const dy1 = p1.y - p2.y;
    const dy2 = p3.y - p2.y;
    const dy3 = p0.y - p1.y + p2.y - p3.y;
    const den = dx1 * dy2 - dx2 * dy1;
    let g = 0, h = 0;
    if (Math.abs(den) > 1e-8) {
      g = (dx3 * dy2 - dx2 * dy3) / den;
      h = (dx1 * dy3 - dx3 * dy1) / den;
    }
    const a = p1.x - p0.x + g * p1.x;
    const b = p3.x - p0.x + h * p3.x;
    const c = p0.x;
    const d = p1.y - p0.y + g * p1.y;
    const e = p3.y - p0.y + h * p3.y;
    const f = p0.y;
    const z = g * u + h * v + 1;
    return { x: (a * u + b * v + c) / z, y: (d * u + e * v + f) / z };
  }

  function drawProjectiveSourceGrid() {
    if (importState.boardCorners.length !== 4) return;
    const gridStep = 1 / (SIZE - 1);
    for (let i = 1; i < SIZE - 1; i++) {
      const t = i * gridStep;
      const top = mapUnitSquareToQuad(t, 0, importState.boardCorners);
      const bottom = mapUnitSquareToQuad(t, 1, importState.boardCorners);
      const left = mapUnitSquareToQuad(0, t, importState.boardCorners);
      const right = mapUnitSquareToQuad(1, t, importState.boardCorners);
      srcCtx.beginPath();
      srcCtx.moveTo(top.x, top.y);
      srcCtx.lineTo(bottom.x, bottom.y);
      srcCtx.stroke();
      srcCtx.beginPath();
      srcCtx.moveTo(left.x, left.y);
      srcCtx.lineTo(right.x, right.y);
      srcCtx.stroke();
    }
  }

  function lineIntersection(a, b) {
    const det = a.a * b.b - b.a * a.b;
    if (Math.abs(det) < 1e-8) return null;
    return {
      x: (a.b * b.c - b.b * a.c) / det,
      y: (a.c * b.a - b.c * a.a) / det,
    };
  }

  function angularDistance(a, b) {
    let d = Math.abs(a - b) % Math.PI;
    if (d > Math.PI / 2) d = Math.PI - d;
    return d;
  }

  function dedupeQuads(candidates, width, height) {
    const diag = Math.sqrt(width * width + height * height);
    const result = [];
    for (const candidate of candidates) {
      const quad = orderCorners(candidate.quad);
      if (!isUsableQuad(quad, width, height)) continue;
      const duplicate = result.some(existing => {
        const mean = quad.reduce((sum, p, i) => sum + Math.sqrt(dist2(p, existing.quad[i])), 0) / 4;
        return mean < diag * 0.018;
      });
      if (!duplicate) result.push({ ...candidate, quad, area: quadArea(quad) });
    }
    return result;
  }

  function scoreBoardCandidate(gray, quad, workSize = 300) {
    let srcPts = null, dstPts = null, matrix = null, warped = null, blurred = null, edge = null;
    try {
      const ordered = orderCorners(quad);
      srcPts = cv.matFromArray(4, 1, cv.CV_32FC2, ordered.flatMap(p => [p.x, p.y]));
      dstPts = cv.matFromArray(4, 1, cv.CV_32FC2, [0, 0, workSize - 1, 0, workSize - 1, workSize - 1, 0, workSize - 1]);
      matrix = cv.getPerspectiveTransform(srcPts, dstPts);
      warped = new cv.Mat();
      blurred = new cv.Mat();
      edge = new cv.Mat();
      cv.warpPerspective(gray, warped, matrix, new cv.Size(workSize, workSize), cv.INTER_LINEAR, cv.BORDER_REPLICATE);
      cv.GaussianBlur(warped, blurred, new cv.Size(3, 3), 0);
      cv.Canny(blurred, edge, 32, 105);

      const data = edge.data;
      const step = (workSize - 1) / (SIZE - 1);
      const crop = Math.max(5, Math.round(step * 0.35));
      const searchRadius = Math.max(2, Math.round(step * 0.14));
      const segmentCount = SIZE - 1;

      function strengthAt(pos, vertical) {
        let bestStrength = 0;
        let bestContinuity = 0;
        for (let offset = -searchRadius; offset <= searchRadius; offset++) {
          const fixed = clamp(Math.round(pos + offset), 0, workSize - 1);
          let hits = 0;
          let liveSegments = 0;
